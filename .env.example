# Copy to .env and fill in. Never commit the real .env.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=openai/gpt-oss-120b

# Required for POST /verify. Fails closed if unset: the server will reject
# every /verify request, not run with auth disabled. Generate a real random
# key, don't type one by hand:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ANTICASSIOPEIA_API_KEY=

# Optional. Primary candidate-search backend for research_web's mode 2
# (_tavily_search in anticassiopeia/domains/research_web.py). If unset,
# that mode falls back to keyless DuckDuckGo+Wikipedia search (narrower,
# and DDG is anti-bot-blocked from most datacenter/cloud IPs) -- it still
# works without this key, just with weaker candidate discovery.
TAVILY_API_KEY=
